# Ambiente
NODE_ENV=development

# Servidor
PORT=3000

# Banco de dados local (PostgreSQL — PLAN-070)
# Local: suba `docker compose up -d postgres` (porta 5433) — o default da app é localhost:5433.
DATABASE_URL=postgres://nxgest:nxgest-dev@localhost:5433/nxgest

# Uploads (anexos de clientes)
UPLOADS_DIR=uploads
PG_DB=nxgest
PG_USER=nxgest
PG_PASSWORD=nxgest-dev
# Pool PG (PLAN-077 — performance): timeouts evitam que rajadas de queries pendurem requests.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000

# Segurança
JWT_SECRET=gere-uma-chave-segura-aqui
ADMIN_DEFAULT_PASSWORD=admin123

# Super Admin (seed inicial)
SUPER_ADMIN_EMAIL=super@nxgest.com
SUPER_ADMIN_DEFAULT_PASSWORD=super123

# CORS (apenas produção, opcional em dev)
CORS_ORIGIN=

# E-mail transacional (PLAN-065/071) — Resend
# development NUNCA envia e-mail real (regra dura: ConsoleMailer, ignora a chave).
# Em staging/produção: MAIL_PROVIDER=resend + RESEND_API_KEY para enviar de verdade.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM_NAME=NX Gest
MAIL_FROM_ADDRESS=no-reply@nxgest.com.br
APP_URL=http://localhost:3000

# Board dev (PLAN-078) — proxy da GitHub API
# Token de acesso pessoal do GitHub (scope: repo) — definido no .env do servidor,
# nunca versionado. Ausente → endpoints /api/devboard respondem 503 GITHUB_TOKEN_AUSENTE.
GITHUB_TOKEN=

# Rate limits
LOGIN_RATE_LIMIT_MAX=10
PUBLICO_RATE_LIMIT_MAX=10
USER_RATE_LIMIT_MAX=600
