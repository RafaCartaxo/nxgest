# Ambiente
NODE_ENV=development

# Servidor
PORT=3000

# Banco de dados local (SQLite)
DB_PATH=gestao.db

# Segurança
JWT_SECRET=gere-uma-chave-segura-aqui
ADMIN_DEFAULT_PASSWORD=admin123

# Super Admin (seed inicial)
SUPER_ADMIN_EMAIL=super@nxgestao.com
SUPER_ADMIN_DEFAULT_PASSWORD=super123

# CORS (apenas produção, opcional em dev)
CORS_ORIGIN=

# E-mail transacional (PLAN-065) — Resend
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=no-reply@nxgest.com.br
APP_URL=http://localhost:3000
