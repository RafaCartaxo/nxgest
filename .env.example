# Ambiente
NODE_ENV=development

# Servidor
PORT=3000

# Banco de dados local (SQLite)
DB_PATH=gestao.db

# Segurança
JWT_SECRET=gere-uma-chave-segura-aqui
ADMIN_DEFAULT_PASSWORD=admin123

# Super Admin (seed inicial)
SUPER_ADMIN_EMAIL=super@nxgestao.com
