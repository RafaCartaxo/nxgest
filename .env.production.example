# Domínio (Caddyfile + CORS) — PLAN-068: oficial após a migração
DOMAIN=nxgest.com.br
CORS_ORIGIN=https://nxgest.com.br

# Segurança — gerar valores fortes
JWT_SECRET=uuidgen
ADMIN_DEFAULT_PASSWORD=uuidgen | cut -c1-16

# Super Admin (seed inicial)
SUPER_ADMIN_EMAIL=super@nxgest.com
SUPER_ADMIN_DEFAULT_PASSWORD=uuidgen

# Banco de dados (PostgreSQL — PLAN-070)
# O compose passa o DATABASE_URL do app usando estes valores (serviço interno `postgres`).
# No VPS, gerar PG_PASSWORD forte (openssl rand -hex 16) e setar no .env antes do cutover.
DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@postgres:5432/${PG_DB}
PG_DB=nxgest
PG_USER=nxgest
PG_PASSWORD=uuidgen | cut -c1-16

# E-mail transacional (PLAN-065/071) — Resend
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
MAIL_FROM_NAME=NX Gest
MAIL_FROM_ADDRESS=no-reply@nxgest.com.br
APP_URL=https://nxgest.com.br

# Rate limits
LOGIN_RATE_LIMIT_MAX=10
USER_RATE_LIMIT_MAX=600
