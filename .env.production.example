# Domínio (Caddyfile + CORS) — PLAN-068: oficial após a migração
DOMAIN=nxgest.com.br
CORS_ORIGIN=https://nxgest.com.br

# Segurança — gerar valores fortes
JWT_SECRET=uuidgen
ADMIN_DEFAULT_PASSWORD=uuidgen | cut -c1-16

# Super Admin (seed inicial)
SUPER_ADMIN_EMAIL=super@nxgest.com
SUPER_ADMIN_DEFAULT_PASSWORD=uuidgen

# E-mail transacional (PLAN-065) — Resend
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
MAIL_FROM=no-reply@nxgest.com.br
APP_URL=https://nxgest.com.br

# Rate limits
LOGIN_RATE_LIMIT_MAX=10
USER_RATE_LIMIT_MAX=600
