{
  "name": "nxgestao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/main.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "tsc && cd frontend && npm run build",
    "start": "NODE_ENV=production node dist/main.js",
    "test": "vitest run",
    "docs:audit": "node scripts/audit-docs.mjs",
    "audit:styles": "node scripts/audit-styles.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "docs:collection": "node scripts/build-collection.mjs",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.0",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
